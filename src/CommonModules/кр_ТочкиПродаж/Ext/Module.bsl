// Элемент ответа Overpass -> структура полей регистра или Неопределено, если у элемента нет координат.
Функция ОписаниеТочкиOSM(ЭлементОтвета)

	КоординатыЭлемента = ЭлементОтвета.Получить("center");
	Если КоординатыЭлемента = Неопределено Тогда
		КоординатыЭлемента = ЭлементОтвета;
	КонецЕсли;
	Если КоординатыЭлемента.Получить("lat") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТегиЭлемента = ЭлементОтвета.Получить("tags");
	Если ТегиЭлемента = Неопределено Тогда
		ТегиЭлемента = Новый Соответствие;
	КонецЕсли;

	ОписаниеТочки = Новый Структура("Идентификатор, Широта, Долгота, Название, Вид, Категория, Адрес");
	ОписаниеТочки.Идентификатор = ЭлементОтвета.Получить("type") + "/" + Формат(ЭлементОтвета.Получить("id"), "ЧГ=0");
	ОписаниеТочки.Широта = КоординатыЭлемента.Получить("lat");
	ОписаниеТочки.Долгота = КоординатыЭлемента.Получить("lon");
	ОписаниеТочки.Название = Лев(ЗначениеТега(ТегиЭлемента, "name", ЗначениеТега(ТегиЭлемента, "brand", "")), 200);

	ВидМагазина = ЗначениеТега(ТегиЭлемента, "shop", "");
	ВидЗаведения = ЗначениеТега(ТегиЭлемента, "amenity", "");
	Если ВидыМагазиновПродуктов().Найти(ВидМагазина) <> Неопределено Тогда
		ОписаниеТочки.Вид = ВидМагазина;
		ОписаниеТочки.Категория = "Продукты";
	ИначеЕсли ВидыОбщепита().Найти(ВидЗаведения) <> Неопределено Тогда
		ОписаниеТочки.Вид = ВидЗаведения;
		ОписаниеТочки.Категория = "Общепит";
	Иначе
		ОписаниеТочки.Вид = ВидЗаведения;
		ОписаниеТочки.Категория = "Бары и рестораны";
	КонецЕсли;

	ЧастиАдреса = Новый Массив;
	Для Каждого ИмяТега Из СтрРазделить("addr:city,addr:street,addr:housenumber", ",") Цикл
		ЗначениеЧасти = ЗначениеТега(ТегиЭлемента, ИмяТега, "");
		Если ЗначениеЗаполнено(ЗначениеЧасти) Тогда
			ЧастиАдреса.Добавить(ЗначениеЧасти);
		КонецЕсли;
	КонецЦикла;
	ОписаниеТочки.Адрес = Лев(СтрСоединить(ЧастиАдреса, ", "), 300);

	Возврат ОписаниеТочки;

КонецФункции

Функция ЗначениеТега(ТегиЭлемента, ИмяТега, ЗначениеПоУмолчанию)

	ЗначениеТегаЭлемента = ТегиЭлемента.Получить(ИмяТега);
	Возврат ?(ЗначениеТегаЭлемента = Неопределено, ЗначениеПоУмолчанию, ЗначениеТегаЭлемента);

КонецФункции

// Договоры с найденными координатами, разложенные по ячейкам сетки 0,01 градуса (около 1 км по широте).
Функция КлиентыПоЯчейкамСетки()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Координаты.Объект КАК Договор,
	|	Координаты.Широта КАК Широта,
	|	Координаты.Долгота КАК Долгота
	|ИЗ
	|	РегистрСведений.кр_КоординатыОбъектов КАК Координаты
	|ГДЕ
	|	Координаты.Широта <> 0
	|	И Координаты.Объект ССЫЛКА Справочник.ДоговорыКонтрагентов");

	КлиентыПоЯчейкам = Новый Соответствие;
	ВыборкаКлиентов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКлиентов.Следующий() Цикл
		ДобавитьВЯчейку(КлиентыПоЯчейкам, ВыборкаКлиентов.Широта, ВыборкаКлиентов.Долгота,
			Новый Структура("Договор, Широта, Долгота", ВыборкаКлиентов.Договор, ВыборкаКлиентов.Широта, ВыборкаКлиентов.Долгота));
	КонецЦикла;

	Возврат КлиентыПоЯчейкам;

КонецФункции

Функция КлючЯчейки(ШиротаЯчейки, ДолготаЯчейки)

	Возврат Формат(ШиротаЯчейки, "ЧН=0; ЧГ=0") + "|" + Формат(ДолготаЯчейки, "ЧН=0; ЧГ=0");

КонецФункции

// Приближение для расстояний до километров: плоская проекция с поправкой долготы на широту.
Функция РасстояниеМетров(ПерваяШирота, ПерваяДолгота, ВтораяШирота, ВтораяДолгота)

	МетровВГрадусе = 111320;
	ПоправкаДолготы = Cos((ПерваяШирота + ВтораяШирота) / 2 * 3.14159265358979 / 180);
	РазницаШироты = (ПерваяШирота - ВтораяШирота) * МетровВГрадусе;
	РазницаДолготы = (ПерваяДолгота - ВтораяДолгота) * МетровВГрадусе * ПоправкаДолготы;

	Возврат Sqrt(РазницаШироты * РазницаШироты + РазницаДолготы * РазницаДолготы);

КонецФункции

Функция ЧислоИлиНоль(ЗначениеЧисла)

	Возврат ?(ТипЗнч(ЗначениеЧисла) = Тип("Число"), ЗначениеЧисла, 0);

КонецФункции


#Область ПрограммныйИнтерфейс

// Загружает из OpenStreetMap магазины продуктов и общепит Пермского края в регистр кр_ТочкиПродаж
// (точки источника OSM заменяются целиком) и пересчитывает ближайших клиентов.
//
// Возвращаемое значение:
//  Структура - Успешно (Булево), Описание (Строка).
//
Функция ЗагрузитьТочкиOSM() Экспорт

	РезультатЗагрузки = Новый Структура("Успешно, Описание", Ложь, "");

	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса.Вставить("User-Agent", "map-1c/1.0 (+https://github.com/rsyuzyov/map-1c)");
	ЗаголовкиЗапроса.Вставить("Content-Type", "application/x-www-form-urlencoded");
	HTTPЗапрос = Новый HTTPЗапрос("/api/interpreter", ЗаголовкиЗапроса);
	HTTPЗапрос.УстановитьТелоИзСтроки("data=" + КодироватьСтроку(ТекстЗапросаOverpass(), СпособКодированияСтроки.КодировкаURL),
		"UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение("overpass-api.de", 443, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		РезультатЗагрузки.Описание = "Overpass недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатЗагрузки;
	КонецПопытки;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		РезультатЗагрузки.Описание = "Overpass ответил HTTP " + HTTPОтвет.КодСостояния;
		Возврат РезультатЗагрузки;
	КонецЕсли;

	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	ДанныеОтвета = ПрочитатьJSON(ЧтениеОтвета, Истина);
	ЧтениеОтвета.Закрыть();

	ЭлементыОтвета = ДанныеОтвета.Получить("elements");
	Если ЭлементыОтвета = Неопределено Или ЭлементыОтвета.Количество() = 0 Тогда
		РезультатЗагрузки.Описание = "Overpass вернул пустой ответ, прежние точки оставлены";
		Возврат РезультатЗагрузки;
	КонецЕсли;

	МоментЗагрузки = ТекущаяДатаСеанса();
	НаборТочек = РегистрыСведений.кр_ТочкиПродаж.СоздатьНаборЗаписей();
	НаборТочек.Отбор.Источник.Установить("OSM");
	ТочекПоКатегориям = Новый Соответствие;
	Для Каждого ЭлементОтвета Из ЭлементыОтвета Цикл
		ОписаниеТочки = ОписаниеТочкиOSM(ЭлементОтвета);
		Если ОписаниеТочки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьТочки = НаборТочек.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьТочки, ОписаниеТочки);
		ЗаписьТочки.Источник = "OSM";
		ЗаписьТочки.ДатаЗагрузки = МоментЗагрузки;
		ТочекПоКатегориям.Вставить(ОписаниеТочки.Категория, ЧислоИлиНоль(ТочекПоКатегориям.Получить(ОписаниеТочки.Категория)) + 1);
	КонецЦикла;
	НаборТочек.Записать();

	ПересчитатьБлижайшихКлиентов();

	ЧастиОписания = Новый Массив;
	Для Каждого КатегорияИКоличество Из ТочекПоКатегориям Цикл
		ЧастиОписания.Добавить(СтрШаблон("%1: %2", КатегорияИКоличество.Ключ, КатегорияИКоличество.Значение));
	КонецЦикла;
	РезультатЗагрузки.Успешно = Истина;
	РезультатЗагрузки.Описание = СтрШаблон("Загружено точек OSM: %1 (%2)", НаборТочек.Количество(), СтрСоединить(ЧастиОписания, ", "));

	Возврат РезультатЗагрузки;

КонецФункции

// Для каждой точки регистра кр_ТочкиПродаж находит ближайшего клиента из регистра координат договоров
// в пределах примерно километра и записывает договор и расстояние; дальше - договор пустой, расстояние 0.
Процедура ПересчитатьБлижайшихКлиентов() Экспорт

	КлиентыПоЯчейкам = КлиентыПоЯчейкамСетки();

	НаборТочек = РегистрыСведений.кр_ТочкиПродаж.СоздатьНаборЗаписей();
	НаборТочек.Прочитать();
	Для Каждого ЗаписьТочки Из НаборТочек Цикл
		БлижайшийДоговор = Неопределено;
		НаименьшееРасстояние = 0;
		ШиротаЯчейки = Окр(ЗаписьТочки.Широта * 100);
		ДолготаЯчейки = Окр(ЗаписьТочки.Долгота * 100);
		Для СдвигШироты = -1 По 1 Цикл
			Для СдвигДолготы = -1 По 1 Цикл
				КлиентыЯчейки = КлиентыПоЯчейкам.Получить(КлючЯчейки(ШиротаЯчейки + СдвигШироты, ДолготаЯчейки + СдвигДолготы));
				Если КлиентыЯчейки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого КлиентЯчейки Из КлиентыЯчейки Цикл
					РасстояниеДоКлиента = РасстояниеМетров(ЗаписьТочки.Широта, ЗаписьТочки.Долгота, КлиентЯчейки.Широта, КлиентЯчейки.Долгота);
					Если БлижайшийДоговор = Неопределено Или РасстояниеДоКлиента < НаименьшееРасстояние Тогда
						БлижайшийДоговор = КлиентЯчейки.Договор;
						НаименьшееРасстояние = РасстояниеДоКлиента;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ЗаписьТочки.БлижайшийДоговор = БлижайшийДоговор;
		ЗаписьТочки.РасстояниеДоКлиента = ?(БлижайшийДоговор = Неопределено, 0, Окр(НаименьшееРасстояние));
	КонецЦикла;
	НаборТочек.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаOverpass()

	Возврат "[out:json][timeout:240];
	|area[""ISO3166-2""=""RU-PER""]->.regionArea;
	|(
	|  nwr[""shop""~""^(" + СтрСоединить(ВидыМагазиновПродуктов(), "|") + ")$""](area.regionArea);
	|  nwr[""amenity""~""^(" + СтрСоединить(ВидыОбщепита(), "|") + "|" + СтрСоединить(ВидыБаровИРесторанов(), "|") + ")$""](area.regionArea);
	|);
	|out center tags qt;";

КонецФункции

Функция ВидыМагазиновПродуктов()

	Возврат СтрРазделить("supermarket,convenience,grocery,food,butcher,bakery,dairy,greengrocer,deli,frozen_food,beverages,"
		+ "alcohol,confectionery,seafood,general,variety_store", ",");

КонецФункции

Функция ВидыОбщепита()

	Возврат СтрРазделить("cafe,fast_food,canteen,food_court", ",");

КонецФункции

Функция ВидыБаровИРесторанов()

	Возврат СтрРазделить("restaurant,bar,pub", ",");

КонецФункции

// Элемент ответа Overpass -> структура полей регистра или Неопределено, если у элемента нет координат.
Функция ОписаниеТочкиOSM(ЭлементОтвета)

	КоординатыЭлемента = ЭлементОтвета.Получить("center");
	Если КоординатыЭлемента = Неопределено Тогда
		КоординатыЭлемента = ЭлементОтвета;
	КонецЕсли;
	Если КоординатыЭлемента.Получить("lat") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТегиЭлемента = ЭлементОтвета.Получить("tags");
	Если ТегиЭлемента = Неопределено Тогда
		ТегиЭлемента = Новый Соответствие;
	КонецЕсли;

	ОписаниеТочки = Новый Структура("Идентификатор, Широта, Долгота, Название, Вид, Категория, Адрес");
	ОписаниеТочки.Идентификатор = ЭлементОтвета.Получить("type") + "/" + Формат(ЭлементОтвета.Получить("id"), "ЧГ=0");
	ОписаниеТочки.Широта = КоординатыЭлемента.Получить("lat");
	ОписаниеТочки.Долгота = КоординатыЭлемента.Получить("lon");
	ОписаниеТочки.Название = Лев(ЗначениеТега(ТегиЭлемента, "name", ЗначениеТега(ТегиЭлемента, "brand", "")), 200);

	ВидМагазина = ЗначениеТега(ТегиЭлемента, "shop", "");
	ВидЗаведения = ЗначениеТега(ТегиЭлемента, "amenity", "");
	Если ВидыМагазиновПродуктов().Найти(ВидМагазина) <> Неопределено Тогда
		ОписаниеТочки.Вид = ВидМагазина;
		ОписаниеТочки.Категория = "Продукты";
	ИначеЕсли ВидыОбщепита().Найти(ВидЗаведения) <> Неопределено Тогда
		ОписаниеТочки.Вид = ВидЗаведения;
		ОписаниеТочки.Категория = "Общепит";
	Иначе
		ОписаниеТочки.Вид = ВидЗаведения;
		ОписаниеТочки.Категория = "Бары и рестораны";
	КонецЕсли;

	ЧастиАдреса = Новый Массив;
	Для Каждого ИмяТега Из СтрРазделить("addr:city,addr:street,addr:housenumber", ",") Цикл
		ЗначениеЧасти = ЗначениеТега(ТегиЭлемента, ИмяТега, "");
		Если ЗначениеЗаполнено(ЗначениеЧасти) Тогда
			ЧастиАдреса.Добавить(ЗначениеЧасти);
		КонецЕсли;
	КонецЦикла;
	ОписаниеТочки.Адрес = Лев(СтрСоединить(ЧастиАдреса, ", "), 300);

	Возврат ОписаниеТочки;

КонецФункции

Функция ЗначениеТега(ТегиЭлемента, ИмяТега, ЗначениеПоУмолчанию)

	ЗначениеТегаЭлемента = ТегиЭлемента.Получить(ИмяТега);
	Возврат ?(ЗначениеТегаЭлемента = Неопределено, ЗначениеПоУмолчанию, ЗначениеТегаЭлемента);

КонецФункции

// Договоры с найденными координатами, разложенные по ячейкам сетки 0,01 градуса (около 1 км по широте).
Функция КлиентыПоЯчейкамСетки()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Координаты.Объект КАК Договор,
	|	Координаты.Широта КАК Широта,
	|	Координаты.Долгота КАК Долгота
	|ИЗ
	|	РегистрСведений.кр_КоординатыОбъектов КАК Координаты
	|ГДЕ
	|	Координаты.Широта <> 0
	|	И Координаты.Объект ССЫЛКА Справочник.ДоговорыКонтрагентов");

	КлиентыПоЯчейкам = Новый Соответствие;
	ВыборкаКлиентов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКлиентов.Следующий() Цикл
		КлючКлиента = КлючЯчейки(Окр(ВыборкаКлиентов.Широта * 100), Окр(ВыборкаКлиентов.Долгота * 100));
		КлиентыЯчейки = КлиентыПоЯчейкам.Получить(КлючКлиента);
		Если КлиентыЯчейки = Неопределено Тогда
			КлиентыЯчейки = Новый Массив;
			КлиентыПоЯчейкам.Вставить(КлючКлиента, КлиентыЯчейки);
		КонецЕсли;
		КлиентыЯчейки.Добавить(Новый Структура("Договор, Широта, Долгота",
			ВыборкаКлиентов.Договор, ВыборкаКлиентов.Широта, ВыборкаКлиентов.Долгота));
	КонецЦикла;

	Возврат КлиентыПоЯчейкам;

КонецФункции

Функция КлючЯчейки(ШиротаЯчейки, ДолготаЯчейки)

	Возврат Формат(ШиротаЯчейки, "ЧН=0; ЧГ=0") + "|" + Формат(ДолготаЯчейки, "ЧН=0; ЧГ=0");

КонецФункции

// Приближение для расстояний до километров: плоская проекция с поправкой долготы на широту.
Функция РасстояниеМетров(ПерваяШирота, ПерваяДолгота, ВтораяШирота, ВтораяДолгота)

	МетровВГрадусе = 111320;
	ПоправкаДолготы = Cos((ПерваяШирота + ВтораяШирота) / 2 * 3.14159265358979 / 180);
	РазницаШироты = (ПерваяШирота - ВтораяШирота) * МетровВГрадусе;
	РазницаДолготы = (ПерваяДолгота - ВтораяДолгота) * МетровВГрадусе * ПоправкаДолготы;

	Возврат Sqrt(РазницаШироты * РазницаШироты + РазницаДолготы * РазницаДолготы);

КонецФункции

Функция ЧислоИлиНоль(ЗначениеЧисла)

	Возврат ?(ТипЗнч(ЗначениеЧисла) = Тип("Число"), ЗначениеЧисла, 0);

КонецФункции

#КонецОбласти

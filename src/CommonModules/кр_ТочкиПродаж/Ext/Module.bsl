#Область ПрограммныйИнтерфейс

// Загружает из OpenStreetMap магазины продуктов и общепит Пермского края в регистр кр_ТочкиПродаж
// (точки источника OSM заменяются целиком) и пересчитывает ближайших клиентов.
//
// Возвращаемое значение:
//  Структура - Успешно (Булево), Описание (Строка).
//
Функция ЗагрузитьТочкиOSM() Экспорт

	РезультатЗагрузки = Новый Структура("Успешно, Описание", Ложь, "");

	ДанныеОтвета = ОтветOverpass(ТекстЗапросаOverpass(), РезультатЗагрузки);
	Если ДанныеОтвета = Неопределено Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;

	ЭлементыОтвета = ДанныеОтвета.Получить("elements");
	Если ЭлементыОтвета = Неопределено Или ЭлементыОтвета.Количество() = 0 Тогда
		РезультатЗагрузки.Описание = "Overpass вернул пустой ответ, прежние точки оставлены";
		Возврат РезультатЗагрузки;
	КонецЕсли;

	МоментЗагрузки = ТекущаяДатаСеанса();
	НаборТочек = РегистрыСведений.кр_ТочкиПродаж.СоздатьНаборЗаписей();
	НаборТочек.Отбор.Источник.Установить("OSM");
	ТочекПоКатегориям = Новый Соответствие;
	Для Каждого ЭлементОтвета Из ЭлементыОтвета Цикл
		ОписаниеТочки = ОписаниеТочкиOSM(ЭлементОтвета);
		Если ОписаниеТочки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьТочки = НаборТочек.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьТочки, ОписаниеТочки);
		ЗаписьТочки.Источник = "OSM";
		ЗаписьТочки.ДатаЗагрузки = МоментЗагрузки;
		ТочекПоКатегориям.Вставить(ОписаниеТочки.Категория, ЧислоИлиНоль(ТочекПоКатегориям.Получить(ОписаниеТочки.Категория)) + 1);
	КонецЦикла;
	НаборТочек.Записать();

	ПересчитатьБлижайшихКлиентов();

	ЧастиОписания = Новый Массив;
	Для Каждого КатегорияИКоличество Из ТочекПоКатегориям Цикл
		ЧастиОписания.Добавить(СтрШаблон("%1: %2", КатегорияИКоличество.Ключ, КатегорияИКоличество.Значение));
	КонецЦикла;
	РезультатЗагрузки.Успешно = Истина;
	РезультатЗагрузки.Описание = СтрШаблон("Загружено точек OSM: %1 (%2)", НаборТочек.Количество(), СтрСоединить(ЧастиОписания, ", "));

	Возврат РезультатЗагрузки;

КонецФункции

// Для каждой точки регистра кр_ТочкиПродаж находит ближайшего клиента из регистра координат договоров
// в пределах примерно километра и записывает договор и расстояние; дальше - договор пустой, расстояние 0.
Процедура ПересчитатьБлижайшихКлиентов() Экспорт

	КлиентыПоЯчейкам = КлиентыПоЯчейкамСетки();

	НаборТочек = РегистрыСведений.кр_ТочкиПродаж.СоздатьНаборЗаписей();
	НаборТочек.Прочитать();
	Для Каждого ЗаписьТочки Из НаборТочек Цикл
		БлижайшийДоговор = Неопределено;
		НаименьшееРасстояние = 0;
		ШиротаЯчейки = Окр(ЗаписьТочки.Широта * 100);
		ДолготаЯчейки = Окр(ЗаписьТочки.Долгота * 100);
		Для СдвигШироты = -1 По 1 Цикл
			Для СдвигДолготы = -1 По 1 Цикл
				КлиентыЯчейки = КлиентыПоЯчейкам.Получить(КлючЯчейки(ШиротаЯчейки + СдвигШироты, ДолготаЯчейки + СдвигДолготы));
				Если КлиентыЯчейки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого КлиентЯчейки Из КлиентыЯчейки Цикл
					РасстояниеДоКлиента = РасстояниеМетров(ЗаписьТочки.Широта, ЗаписьТочки.Долгота, КлиентЯчейки.Широта, КлиентЯчейки.Долгота);
					Если БлижайшийДоговор = Неопределено Или РасстояниеДоКлиента < НаименьшееРасстояние Тогда
						БлижайшийДоговор = КлиентЯчейки.Договор;
						НаименьшееРасстояние = РасстояниеДоКлиента;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ЗаписьТочки.БлижайшийДоговор = БлижайшийДоговор;
		ЗаписьТочки.РасстояниеДоКлиента = ?(БлижайшийДоговор = Неопределено, 0, Окр(НаименьшееРасстояние));
	КонецЦикла;
	НаборТочек.Записать();

КонецПроцедуры

// Точки продаж, рядом с которыми (в 50 м) нет нашего клиента.
//
// Параметры:
//  ТочкиКлиентов - Массив, Неопределено - структуры с полями Широта и Долгота: точки берутся в зоне 2 км вокруг них;
//   Неопределено - все точки края.
//  ВключатьБарыИРестораны - Булево.
//
// Возвращаемое значение:
//  Массив - структуры Широта, Долгота, Заголовок, Описание.
//
Функция ТочкиНеКлиентов(ТочкиКлиентов, ВключатьБарыИРестораны) Экспорт

	РадиусКлиентаМ = 50;
	РадиусЗоныМ = 2000;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Точки.Широта КАК Широта,
	|	Точки.Долгота КАК Долгота,
	|	Точки.Название КАК Название,
	|	Точки.Вид КАК Вид,
	|	Точки.Категория КАК Категория,
	|	Точки.Адрес КАК Адрес
	|ИЗ
	|	РегистрСведений.кр_ТочкиПродаж КАК Точки
	|ГДЕ
	|	(Точки.БлижайшийДоговор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|			ИЛИ Точки.РасстояниеДоКлиента > &РадиусКлиентаМ)
	|	И (&ВключатьБарыИРестораны
	|			ИЛИ Точки.Категория <> ""Бары и рестораны"")");
	Запрос.УстановитьПараметр("РадиусКлиентаМ", РадиусКлиентаМ);
	Запрос.УстановитьПараметр("ВключатьБарыИРестораны", ВключатьБарыИРестораны);

	КлиентыПоЯчейкам = Неопределено;
	Если ТочкиКлиентов <> Неопределено Тогда
		КлиентыПоЯчейкам = Новый Соответствие;
		Для Каждого ТочкаКлиента Из ТочкиКлиентов Цикл
			ДобавитьВЯчейку(КлиентыПоЯчейкам, ТочкаКлиента.Широта, ТочкаКлиента.Долгота,
				Новый Структура("Широта, Долгота", ТочкаКлиента.Широта, ТочкаКлиента.Долгота));
		КонецЦикла;
	КонецЕсли;

	НазванияВидов = НазванияВидовТочек();
	ТочкиНеКлиентов = Новый Массив;
	ВыборкаТочек = Запрос.Выполнить().Выбрать();
	Пока ВыборкаТочек.Следующий() Цикл
		Если КлиентыПоЯчейкам <> Неопределено
			И Не ЕстьТочкаВРадиусе(КлиентыПоЯчейкам, ВыборкаТочек.Широта, ВыборкаТочек.Долгота, РадиусЗоныМ) Тогда
			Продолжить;
		КонецЕсли;

		НазваниеВида = НазванияВидов.Получить(ВыборкаТочек.Вид);
		Если НазваниеВида = Неопределено Тогда
			НазваниеВида = ВыборкаТочек.Вид;
		КонецЕсли;
		ТочкиНеКлиентов.Добавить(Новый Структура("Широта, Долгота, Заголовок, Описание",
			ВыборкаТочек.Широта, ВыборкаТочек.Долгота,
			?(ПустаяСтрока(ВыборкаТочек.Название), НазваниеВида, ВыборкаТочек.Название),
			НазваниеВида + ?(ПустаяСтрока(ВыборкаТочек.Адрес), "", ", " + ВыборкаТочек.Адрес)));
	КонецЦикла;

	Возврат ТочкиНеКлиентов;

КонецФункции

// Загружает из OpenStreetMap границы округов края (admin_level 6) и районов Перми (admin_level 9),
// упрощает линии и сохраняет в константу кр_ГраницыРайонов.
//
// Возвращаемое значение:
//  Структура - Успешно (Булево), Описание (Строка).
//
Функция ЗагрузитьГраницыРайонов() Экспорт

	РезультатЗагрузки = Новый Структура("Успешно, Описание", Ложь, "");

	ДанныеОтвета = ОтветOverpass("[out:json][timeout:240];
	|area[""ISO3166-2""=""RU-PER""]->.regionArea;
	|relation[""boundary""=""administrative""][""admin_level""~""^(6|9)$""](area.regionArea);
	|out geom;", РезультатЗагрузки);
	Если ДанныеОтвета = Неопределено Тогда
		Возврат РезультатЗагрузки;
	КонецЕсли;

	Районы = Новый Массив;
	КоличествоТочек = 0;
	Для Каждого ЭлементОтвета Из ДанныеОтвета.Получить("elements") Цикл
		ТегиЭлемента = ЭлементОтвета.Получить("tags");
		УровеньГраницы = ТегиЭлемента.Получить("admin_level");
		НаименьшийШагМ = ?(УровеньГраницы = "9", 40, 300);
		ЛинииРайона = Новый Массив;
		Для Каждого УчастникГраницы Из ЭлементОтвета.Получить("members") Цикл
			ГеометрияЛинии = УчастникГраницы.Получить("geometry");
			Если УчастникГраницы.Получить("type") <> "way" Или ГеометрияЛинии = Неопределено
				Или УчастникГраницы.Получить("role") = "inner" Тогда
				Продолжить;
			КонецЕсли;
			ЛинияРайона = УпрощеннаяЛиния(ГеометрияЛинии, НаименьшийШагМ);
			КоличествоТочек = КоличествоТочек + ЛинияРайона.Количество();
			ЛинииРайона.Добавить(ЛинияРайона);
		КонецЦикла;
		Районы.Добавить(Новый Структура("name, level, lines", ТегиЭлемента.Получить("name"), УровеньГраницы, ЛинииРайона));
	КонецЦикла;

	Если Районы.Количество() = 0 Тогда
		РезультатЗагрузки.Описание = "Overpass не вернул границ, прежние оставлены";
		Возврат РезультатЗагрузки;
	КонецЕсли;

	ЗаписьГраниц = Новый ЗаписьJSON;
	ЗаписьГраниц.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьГраниц, Районы);
	ТекстГраниц = ЗаписьГраниц.Закрыть();
	Константы.кр_ГраницыРайонов.Установить(Новый ХранилищеЗначения(ТекстГраниц, Новый СжатиеДанных(9)));

	РезультатЗагрузки.Успешно = Истина;
	РезультатЗагрузки.Описание = СтрШаблон("Загружено границ: %1, точек линий: %2, %3 КБ",
		Районы.Количество(), КоличествоТочек, Окр(СтрДлина(ТекстГраниц) / 1024));
	Возврат РезультатЗагрузки;

КонецФункции

// Границы районов для страницы карты: JSON-массив объектов name, level, lines или "[]", если не загружены.
Функция ГраницыРайоновJSON() Экспорт

	ХранилищеГраниц = Константы.кр_ГраницыРайонов.Получить();
	ТекстГраниц = ?(ТипЗнч(ХранилищеГраниц) = Тип("ХранилищеЗначения"), ХранилищеГраниц.Получить(), Неопределено);

	Возврат ?(ТипЗнч(ТекстГраниц) = Тип("Строка") И Не ПустаяСтрока(ТекстГраниц), ТекстГраниц, "[]");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветOverpass(ТекстЗапроса, РезультатЗагрузки)

	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса.Вставить("User-Agent", "map-1c/1.0 (+https://github.com/rsyuzyov/map-1c)");
	ЗаголовкиЗапроса.Вставить("Content-Type", "application/x-www-form-urlencoded");
	HTTPЗапрос = Новый HTTPЗапрос("/api/interpreter", ЗаголовкиЗапроса);
	HTTPЗапрос.УстановитьТелоИзСтроки("data=" + КодироватьСтроку(ТекстЗапроса, СпособКодированияСтроки.КодировкаURL),
		"UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение("overpass-api.de", 443, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		РезультатЗагрузки.Описание = "Overpass недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		РезультатЗагрузки.Описание = "Overpass ответил HTTP " + HTTPОтвет.КодСостояния;
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	ДанныеОтвета = ПрочитатьJSON(ЧтениеОтвета, Истина);
	ЧтениеОтвета.Закрыть();

	Возврат ДанныеОтвета;

КонецФункции

// Линия границы без точек ближе НаименьшийШагМ к предыдущей оставленной; концы сохраняются.
Функция УпрощеннаяЛиния(ГеометрияЛинии, НаименьшийШагМ)

	ЛинияРайона = Новый Массив;
	ПоследняяТочка = Неопределено;
	ПоследнийНомер = ГеометрияЛинии.Количество() - 1;
	Для НомерТочки = 0 По ПоследнийНомер Цикл
		ТочкаЛинии = ГеометрияЛинии[НомерТочки];
		Если ПоследняяТочка <> Неопределено И НомерТочки < ПоследнийНомер
			И РасстояниеМетров(ПоследняяТочка.Получить("lat"), ПоследняяТочка.Получить("lon"),
				ТочкаЛинии.Получить("lat"), ТочкаЛинии.Получить("lon")) < НаименьшийШагМ Тогда
			Продолжить;
		КонецЕсли;
		ЛинияРайона.Добавить(Окр(ТочкаЛинии.Получить("lat"), 4));
		ЛинияРайона.Добавить(Окр(ТочкаЛинии.Получить("lon"), 4));
		ПоследняяТочка = ТочкаЛинии;
	КонецЦикла;

	Возврат ЛинияРайона;

КонецФункции

Процедура ДобавитьВЯчейку(ЗначенияПоЯчейкам, Широта, Долгота, ЗначениеЯчейки)

	КлючЗначения = КлючЯчейки(Окр(Широта * 100), Окр(Долгота * 100));
	ЗначенияЯчейки = ЗначенияПоЯчейкам.Получить(КлючЗначения);
	Если ЗначенияЯчейки = Неопределено Тогда
		ЗначенияЯчейки = Новый Массив;
		ЗначенияПоЯчейкам.Вставить(КлючЗначения, ЗначенияЯчейки);
	КонецЕсли;
	ЗначенияЯчейки.Добавить(ЗначениеЯчейки);

КонецПроцедуры

// Ячейка сетки - 0,01 градуса: около 1,1 км по широте и 0,6 км по долготе на широте края.
Функция ЕстьТочкаВРадиусе(ТочкиПоЯчейкам, Широта, Долгота, РадиусМ)

	ЯчеекПоШироте = Цел(РадиусМ / 1100) + 1;
	ЯчеекПоДолготе = Цел(РадиусМ / 580) + 1;
	ШиротаЯчейки = Окр(Широта * 100);
	ДолготаЯчейки = Окр(Долгота * 100);
	Для СдвигШироты = -ЯчеекПоШироте По ЯчеекПоШироте Цикл
		Для СдвигДолготы = -ЯчеекПоДолготе По ЯчеекПоДолготе Цикл
			ТочкиЯчейки = ТочкиПоЯчейкам.Получить(КлючЯчейки(ШиротаЯчейки + СдвигШироты, ДолготаЯчейки + СдвигДолготы));
			Если ТочкиЯчейки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТочкаЯчейки Из ТочкиЯчейки Цикл
				Если РасстояниеМетров(Широта, Долгота, ТочкаЯчейки.Широта, ТочкаЯчейки.Долгота) <= РадиусМ Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НазванияВидовТочек()

	НазванияВидов = Новый Соответствие;
	Для Каждого ПараНазваний Из СтрРазделить("supermarket=Супермаркет;convenience=Магазин у дома;grocery=Продукты;food=Продукты;"
		+ "butcher=Мясной магазин;bakery=Пекарня;dairy=Молочный магазин;greengrocer=Овощи и фрукты;deli=Деликатесы;"
		+ "frozen_food=Замороженные продукты;beverages=Напитки;alcohol=Алкоголь;confectionery=Кондитерская;seafood=Рыба и морепродукты;"
		+ "general=Универсальный магазин;variety_store=Магазин низких цен;cafe=Кафе;fast_food=Фастфуд;canteen=Столовая;"
		+ "food_court=Фудкорт;restaurant=Ресторан;bar=Бар;pub=Паб", ";") Цикл
		ЧастиПары = СтрРазделить(ПараНазваний, "=");
		НазванияВидов.Вставить(ЧастиПары[0], ЧастиПары[1]);
	КонецЦикла;

	Возврат НазванияВидов;

КонецФункции

Функция ТекстЗапросаOverpass()

	Возврат "[out:json][timeout:240];
	|area[""ISO3166-2""=""RU-PER""]->.regionArea;
	|(
	|  nwr[""shop""~""^(" + СтрСоединить(ВидыМагазиновПродуктов(), "|") + ")$""](area.regionArea);
	|  nwr[""amenity""~""^(" + СтрСоединить(ВидыОбщепита(), "|") + "|" + СтрСоединить(ВидыБаровИРесторанов(), "|") + ")$""](area.regionArea);
	|);
	|out center tags qt;";

КонецФункции

Функция ВидыМагазиновПродуктов()


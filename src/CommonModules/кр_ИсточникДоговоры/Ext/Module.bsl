#Область ПрограммныйИнтерфейс

// Договоры покупателей торгового представителя (Проект договора, с подчиненными) с продажами за последний год.
// Колонки: Договор, Контрагент, Наименование, Адрес. Адрес - из договора, иначе фактический адрес контрагента.
Функция ДоговорыТорговогоПредставителя(ТорговыйПредставитель) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Продажи.ДоговорКонтрагента КАК Договор
	|ПОМЕСТИТЬ ДоговорыСПродажами
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, , , ) КАК Продажи
	|ГДЕ
	|	Продажи.ДоговорКонтрагента.Проект В ИЕРАРХИИ (&ТорговыйПредставитель)
	|;
	|
	|ВЫБРАТЬ
	|	АдресаОбъектов.Объект КАК ОбъектАдреса,
	|	МАКСИМУМ(ПОДСТРОКА(АдресаОбъектов.Представление, 1, 500)) КАК Адрес
	|ПОМЕСТИТЬ Адреса
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК АдресаОбъектов
	|ГДЕ
	|	АдресаОбъектов.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И АдресаОбъектов.Вид.Наименование В (""Адрес доставки"", ""Фактический адрес контрагента"")
	|	И ПОДСТРОКА(АдресаОбъектов.Представление, 1, 500) <> """"
	|СГРУППИРОВАТЬ ПО
	|	АдресаОбъектов.Объект
	|;
	|
	|ВЫБРАТЬ
	|	ДоговорыСПродажами.Договор КАК Договор,
	|	ДоговорыСПродажами.Договор.Владелец КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(ДоговорыСПродажами.Договор.Владелец) КАК ПредставлениеКонтрагента,
	|	ПРЕДСТАВЛЕНИЕ(ДоговорыСПродажами.Договор) КАК ПредставлениеДоговора,
	|	ЕСТЬNULL(АдресДоговора.Адрес, ЕСТЬNULL(АдресКонтрагента.Адрес, """")) КАК Адрес
	|ИЗ
	|	ДоговорыСПродажами КАК ДоговорыСПродажами
	|		ЛЕВОЕ СОЕДИНЕНИЕ Адреса КАК АдресДоговора
	|		ПО (АдресДоговора.ОбъектАдреса = ДоговорыСПродажами.Договор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Адреса КАК АдресКонтрагента
	|		ПО (АдресКонтрагента.ОбъектАдреса = ДоговорыСПродажами.Договор.Владелец)");
	Запрос.УстановитьПараметр("ТорговыйПредставитель", ТорговыйПредставитель);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -12));

	ДоговорыПредставителя = Запрос.Выполнить().Выгрузить();
	ДоговорыПредставителя.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаДоговора Из ДоговорыПредставителя Цикл
		СтрокаДоговора.Наименование = СтрокаДоговора.ПредставлениеКонтрагента + ", " + СтрокаДоговора.ПредставлениеДоговора;
	КонецЦикла;
	ДоговорыПредставителя.Сортировать("Наименование");

	Возврат ДоговорыПредставителя;

КонецФункции

#КонецОбласти

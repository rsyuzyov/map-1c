#Область ПрограммныйИнтерфейс

// Определяет координаты по адресу через Nominatim.
// Адрес, который уже искали, повторно не запрашивается: результат берется из регистра координат.
//
// Параметры:
//  Адрес - Строка - адрес в записи 1С.
//
// Возвращаемое значение:
//  Структура - Найдено, Широта, Долгота, Точность, ОписаниеОшибки, ИзКэша.
//
Функция КоординатыПоАдресу(Адрес) Экспорт

	РезультатГеокодирования = Новый Структура("Найдено, Широта, Долгота, Точность, ОписаниеОшибки, ИзКэша",
		Ложь, 0, 0, "", "", Ложь);

	АдресДляПоиска = ОчищенныйАдрес(Адрес);
	Если ПустаяСтрока(АдресДляПоиска) Тогда
		РезультатГеокодирования.ОписаниеОшибки = "Пустой адрес";
		Возврат РезультатГеокодирования;
	КонецЕсли;

	Если ЗаполнитьИзКэша(РезультатГеокодирования, Адрес) Тогда
		Возврат РезультатГеокодирования;
	КонецЕсли;

	ВыдержатьИнтервалМеждуЗапросами();

	АдресРесурса = "/search?format=jsonv2&limit=1&countrycodes=ru&accept-language=ru&q="
		+ КодироватьСтроку(АдресДляПоиска, СпособКодированияСтроки.КодировкаURL);
	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса.Вставить("User-Agent", ИдентификаторКлиента());
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, ЗаголовкиЗапроса);

	Попытка
		Соединение = Новый HTTPСоединение(АдресСервиса(), 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
	Исключение
		РезультатГеокодирования.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатГеокодирования;
	КонецПопытки;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		РезультатГеокодирования.ОписаниеОшибки = "HTTP " + HTTPОтвет.КодСостояния;
		Возврат РезультатГеокодирования;
	КонецЕсли;

	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	НайденныеМеста = ПрочитатьJSON(ЧтениеОтвета);
	ЧтениеОтвета.Закрыть();

	Если НайденныеМеста.Количество() = 0 Тогда
		РезультатГеокодирования.ОписаниеОшибки = "Адрес не найден";
		Возврат РезультатГеокодирования;
	КонецЕсли;

	НайденноеМесто = НайденныеМеста[0];
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	РезультатГеокодирования.Найдено = Истина;
	РезультатГеокодирования.Широта = ОписаниеЧисла.ПривестиЗначение(СтрЗаменить(НайденноеМесто.lat, ".", ","));
	РезультатГеокодирования.Долгота = ОписаниеЧисла.ПривестиЗначение(СтрЗаменить(НайденноеМесто.lon, ".", ","));
	РезультатГеокодирования.Точность = Лев(Строка(НайденноеМесто.addresstype), 50);

	Возврат РезультатГеокодирования;

КонецФункции

// Приводит адрес в записи 1С к виду, который понимает Nominatim:
// "614025, Пермь г, Героев Хасана ул, дом № 98, корпус 1" -> "Пермь, улица Героев Хасана, 98к1".
//
// Параметры:
//  Адрес - Строка - адрес в записи 1С.
//
// Возвращаемое значение:
//  Строка - адрес для поиска.
//
Функция ОчищенныйАдрес(Адрес) Экспорт

	ЧастиАдреса = Новый Массив;
	НомерДома = "";
	Для Каждого ЧастьАдреса Из СтрРазделить(Адрес, ",", Ложь) Цикл
		ЧистаяЧасть = СокрЛП(СтрЗаменить(ЧастьАдреса, Символы.НПП, " "));
		ЧастьВНижнемРегистре = НРег(ЧистаяЧасть);
		Если ПустаяСтрока(ЧистаяЧасть)
			Или ЭтоПочтовыйИндекс(ЧистаяЧасть)
			Или ЧастьВНижнемРегистре = "россия"
			Или ЕстьПрефикс(ЧастьВНижнемРегистре, "кв,квартира,оф,офис,пом,помещение,литер,лит") Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеДома = ЗначениеПослеПрефикса(ЧистаяЧасть, "дом №,дом,д.,д,владение,вл.");
		Если ЗначениеДома <> Неопределено И СтрНайти("0123456789", Лев(ЗначениеДома, 1)) > 0 Тогда
			НомерДома = НомерДомаИзТекста(ЗначениеДома);
			Продолжить;
		КонецЕсли;
		ЗначениеКорпуса = ЗначениеПослеПрефикса(ЧистаяЧасть, "корпус,корп.,корп,к.");
		Если ЗначениеКорпуса <> Неопределено Тогда
			Если СтрДлина(ЗначениеКорпуса) = 1 И СтрНайти("0123456789", ЗначениеКорпуса) = 0 Тогда
				НомерДома = НомерДома + НРег(ЗначениеКорпуса);
			Иначе
				НомерДома = НомерДома + "к" + ЗначениеКорпуса;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ЗначениеСтроения = ЗначениеПослеПрефикса(ЧистаяЧасть, "строение,стр.,стр");
		Если ЗначениеСтроения <> Неопределено Тогда
			НомерДома = НомерДома + "с" + ЗначениеСтроения;
			Продолжить;
		КонецЕсли;

		ЧастиАдреса.Добавить(РазвернутаяЧастьАдреса(ЧистаяЧасть));
	КонецЦикла;

	Если Не ПустаяСтрока(НомерДома) Тогда
		ЧастиАдреса.Добавить(НомерДома);
	КонецЕсли;

	Возврат СтрСоединить(ЧастиАдреса, ", ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьИзКэша(РезультатГеокодирования, Адрес)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Координаты.Широта КАК Широта,
	|	Координаты.Долгота КАК Долгота,
	|	Координаты.Точность КАК Точность
	|ИЗ
	|	РегистрСведений.кр_КоординатыОбъектов КАК Координаты
	|ГДЕ
	|	Координаты.Адрес = &Адрес
	|	И Координаты.Источник = ""Nominatim""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Координаты.Широта УБЫВ");
	Запрос.УстановитьПараметр("Адрес", Лев(Адрес, 500));

	ВыборкаКэша = Запрос.Выполнить().Выбрать();
	Если Не ВыборкаКэша.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатГеокодирования.ИзКэша = Истина;
	Если ВыборкаКэша.Широта = 0 Тогда
		РезультатГеокодирования.ОписаниеОшибки = "Адрес не найден";
	Иначе
		РезультатГеокодирования.Найдено = Истина;
		РезультатГеокодирования.Широта = ВыборкаКэша.Широта;
		РезультатГеокодирования.Долгота = ВыборкаКэша.Долгота;
		РезультатГеокодирования.Точность = ВыборкаКэша.Точность;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// "Пермь г" -> "Пермь", "Героев Хасана ул" -> "улица Героев Хасана", "ул. Ленина" -> "улица Ленина".
Функция РазвернутаяЧастьАдреса(ЧастьАдреса)

	ТипыУлиц = Новый Соответствие;
	ТипыУлиц.Вставить("ул", "улица");
	ТипыУлиц.Вставить("ул.", "улица");
	ТипыУлиц.Вставить("пр-кт", "проспект");
	ТипыУлиц.Вставить("пр-т", "проспект");
	ТипыУлиц.Вставить("пер", "переулок");
	ТипыУлиц.Вставить("пер.", "переулок");
	ТипыУлиц.Вставить("ш", "шоссе");
	ТипыУлиц.Вставить("б-р", "бульвар");
	ТипыУлиц.Вставить("пл", "площадь");
	ТипыУлиц.Вставить("наб", "набережная");
	ТипыУлиц.Вставить("проезд", "проезд");
	ТипыУлиц.Вставить("тракт", "тракт");
	ТипыУлиц.Вставить("мкр", "микрорайон");
	ТипыУлиц.Вставить("р-н", "район");
	ТипыНаселенныхПунктов = СтрРазделить("г,г.,п,пос,пос.,с,д,рп,пгт,село,деревня,поселок,город", ",");

	Слова = СтрРазделить(ЧастьАдреса, " ", Ложь);
	Если Слова.Количество() < 2 Тогда
		Возврат ЧастьАдреса;
	КонецЕсли;

	ПоследнееСлово = НРег(Слова[Слова.ВГраница()]);
	ПервоеСлово = НРег(Слова[0]);
	Если ТипыНаселенныхПунктов.Найти(ПоследнееСлово) <> Неопределено Тогда
		Слова.Удалить(Слова.ВГраница());
		Возврат СтрСоединить(Слова, " ");
	ИначеЕсли ТипыНаселенныхПунктов.Найти(ПервоеСлово) <> Неопределено Тогда
		Слова.Удалить(0);
		Возврат СтрСоединить(Слова, " ");
	ИначеЕсли ТипыУлиц.Получить(ПоследнееСлово) <> Неопределено Тогда
		ТипУлицы = ТипыУлиц.Получить(ПоследнееСлово);
		Слова.Удалить(Слова.ВГраница());
		Если ТипУлицы = "район" Тогда
			Возврат СтрСоединить(Слова, " ") + " район";
		КонецЕсли;
		Возврат ТипУлицы + " " + СтрСоединить(Слова, " ");
	ИначеЕсли ТипыУлиц.Получить(ПервоеСлово) <> Неопределено Тогда
		ТипУлицы = ТипыУлиц.Получить(ПервоеСлово);
		Слова.Удалить(0);
		Возврат ТипУлицы + " " + СтрСоединить(Слова, " ");
	КонецЕсли;

	Возврат ЧастьАдреса;

КонецФункции

// "19 кафе Саксафон" -> "19", "8 А" -> "8А".
Функция НомерДомаИзТекста(ТекстДома)

	Слова = СтрРазделить(ТекстДома, " ", Ложь);
	НомерДома = Слова[0];
	Если Слова.Количество() > 1 И СтрДлина(Слова[1]) = 1 Тогда
		НомерДома = НомерДома + Слова[1];
	КонецЕсли;

	Возврат НомерДома;

КонецФункции

// Возвращает текст после первого подходящего префикса из списка или Неопределено.
Функция ЗначениеПослеПрефикса(ЧастьАдреса, СписокПрефиксов)

	ЧастьВНижнемРегистре = НРег(ЧастьАдреса);
	Для Каждого Префикс Из СтрРазделить(СписокПрефиксов, ",") Цикл
		Если СтрНачинаетсяС(ЧастьВНижнемРегистре, Префикс + " ") Или (СтрЗаканчиваетсяНа(Префикс, ".")
			И СтрНачинаетсяС(ЧастьВНижнемРегистре, Префикс)) Тогда
			ЗначениеПрефикса = СокрЛП(Сред(ЧастьАдреса, СтрДлина(Префикс) + 1));
			Если Не ПустаяСтрока(ЗначениеПрефикса) Тогда
				Возврат ЗначениеПрефикса;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЕстьПрефикс(ЧастьВНижнемРегистре, СписокПрефиксов)

	Для Каждого Префикс Из СтрРазделить(СписокПрефиксов, ",") Цикл
		Если ЧастьВНижнемРегистре = Префикс
			Или СтрНачинаетсяС(ЧастьВНижнемРегистре, Префикс + " ")
			Или СтрНачинаетсяС(ЧастьВНижнемРегистре, Префикс + ".") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция АдресСервиса()

	НастроенныйАдрес = ХранилищеОбщихНастроек.Загрузить("кр_КартаОбъектов", "АдресГеокодера");
	Если ЗначениеЗаполнено(НастроенныйАдрес) Тогда
		Возврат НастроенныйАдрес;
	КонецЕсли;

	Возврат "nominatim.openstreetmap.org";

КонецФункции

Функция ИдентификаторКлиента()

	Возврат "map-1c/1.0 (+https://github.com/rsyuzyov/map-1c)";

КонецФункции

// Политика публичного Nominatim: не больше одного запроса в секунду.
Процедура ВыдержатьИнтервалМеждуЗапросами()

	КлючПоследнегоЗапроса = "кр_ГеокодерПоследнийЗапрос";
	ВремяПоследнегоЗапроса = ХранилищеОбщихНастроек.Загрузить(КлючПоследнегоЗапроса, "Время");
	Если ТипЗнч(ВремяПоследнегоЗапроса) = Тип("Число") Тогда
		МоментРазрешенногоЗапроса = ВремяПоследнегоЗапроса + 1100;
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментРазрешенногоЗапроса Цикл
			ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецЦикла;
	КонецЕсли;

	ХранилищеОбщихНастроек.Сохранить(КлючПоследнегоЗапроса, "Время", ТекущаяУниверсальнаяДатаВМиллисекундах());

КонецПроцедуры

Функция ЭтоПочтовыйИндекс(ЧастьАдреса)

	Если СтрДлина(ЧастьАдреса) <> 6 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По 6 Цикл
		Если СтрНайти("0123456789", Сред(ЧастьАдреса, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

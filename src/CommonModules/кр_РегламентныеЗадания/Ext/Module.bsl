#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания кр_Догеокодирование: координаты договоров, которых нет на карте
// или у которых изменился адрес. Для регулярных заданий Nominatim разрешает не больше 4 запросов в минуту.
Процедура ДогеокодироватьДоговоры() Экспорт

	ИмяСобытия = "КартаОбъектов.Догеокодирование";
	ИнтервалМеждуЗапросамиМс = 15000;
	ПределВремениМс = 4 * 3600 * 1000;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ДоговорыДляПоиска = кр_ИсточникДоговоры.ДоговорыДляГеокодирования();

	Найдено = 0;
	НеНайдено = 0;
	ИзКэша = 0;
	ОписаниеОстановки = "";
	Для Каждого СтрокаДоговора Из ДоговорыДляПоиска Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала > ПределВремениМс Тогда
			ОписаниеОстановки = "вышло время задания";
			Прервать;
		КонецЕсли;

		РезультатДоговора = кр_Карта.ОпределитьКоординатыДоговора(СтрокаДоговора.Договор, СтрокаДоговора.Адрес,
			ИнтервалМеждуЗапросамиМс);
		Если РезультатДоговора.ИзКэша Тогда
			ИзКэша = ИзКэша + 1;
		КонецЕсли;
		Если РезультатДоговора.Итог = "Найдено" Тогда
			Найдено = Найдено + 1;
		ИначеЕсли РезультатДоговора.Итог = "НеНайдено" Тогда
			НеНайдено = НеНайдено + 1;
		Иначе
			ОписаниеОстановки = "геокодер недоступен: " + РезультатДоговора.ОписаниеОшибки;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ТекстИтога = СтрШаблон("Договоров к поиску: %1, найдено: %2, не найдено: %3, из кэша: %4, за %5 с.",
		ДоговорыДляПоиска.Количество(), Найдено, НеНайдено, ИзКэша,
		Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) / 1000));
	Если ПустаяСтрока(ОписаниеОстановки) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , , ТекстИтога);
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
			"Остановлено, " + ОписаниеОстановки + ". " + ТекстИтога);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

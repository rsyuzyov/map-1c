#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания кр_Догеокодирование: координаты договоров, которых нет на карте
// или у которых изменился адрес. Для регулярных заданий Nominatim разрешает не больше 4 запросов в минуту.
Процедура ДогеокодироватьДоговоры() Экспорт

	ИмяСобытия = "КартаОбъектов.Догеокодирование";
	ИнтервалМеждуЗапросамиМс = 15000;
	ПределВремениМс = 4 * 3600 * 1000;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ДоговорыДляПоиска = кр_ИсточникДоговоры.ДоговорыДляГеокодирования();

	Найдено = 0;
	НеНайдено = 0;
	ИзКэша = 0;
	ОписаниеОстановки = "";
	Для Каждого СтрокаДоговора Из ДоговорыДляПоиска Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала > ПределВремениМс Тогда
			ОписаниеОстановки = "вышло время задания";
			Прервать;
		КонецЕсли;

		РезультатДоговора = кр_Карта.ОпределитьКоординатыДоговора(СтрокаДоговора.Договор, СтрокаДоговора.Адрес,
			ИнтервалМеждуЗапросамиМс);
		Если РезультатДоговора.ИзКэша Тогда
			ИзКэша = ИзКэша + 1;
		КонецЕсли;
		Если РезультатДоговора.Итог = "Найдено" Тогда
			Найдено = Найдено + 1;
		ИначеЕсли РезультатДоговора.Итог = "НеНайдено" Тогда
			НеНайдено = НеНайдено + 1;
		Иначе
			ОписаниеОстановки = "геокодер недоступен: " + РезультатДоговора.ОписаниеОшибки;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Найдено > 0 Тогда
		кр_ТочкиПродаж.ПересчитатьБлижайшихКлиентов();
	КонецЕсли;

	ТекстМеркурия = "";
	ОсталосьВремениМс = ПределВремениМс - (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала);
	Если ПустаяСтрока(ОписаниеОстановки) И ОсталосьВремениМс > 0 Тогда
		ИтогМеркурия = кр_ИсточникМеркурий.ДогеокодироватьПлощадки(ИнтервалМеждуЗапросамиМс, ОсталосьВремениМс);
		ТекстМеркурия = СтрШаблон(" Площадки Меркурия: найдено %1, не найдено %2, осталось %3%4.", ИтогМеркурия.Найдено,
			ИтогМеркурия.НеНайдено, ИтогМеркурия.Осталось,
			?(ПустаяСтрока(ИтогМеркурия.ОписаниеОстановки), "", ", " + ИтогМеркурия.ОписаниеОстановки));
	КонецЕсли;

	ТекстИтога = СтрШаблон("Договоров к поиску: %1, найдено: %2, не найдено: %3, из кэша: %4, за %5 с.",
		ДоговорыДляПоиска.Количество(), Найдено, НеНайдено, ИзКэша,
		Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) / 1000)) + ТекстМеркурия;
	Если ПустаяСтрока(ОписаниеОстановки) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , , ТекстИтога);
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
			"Остановлено, " + ОписаниеОстановки + ". " + ТекстИтога);
	КонецЕсли;

КонецПроцедуры

// Обработчик регламентного задания кр_ЗагрузкаТочекПродаж: точки продаж и границы районов края из OpenStreetMap,
// площадки из ФГИС Меркурий.
Процедура ЗагрузитьТочкиПродаж() Экспорт

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РезультатЗагрузки = кр_ТочкиПродаж.ЗагрузитьТочкиOSM();
	РезультатГраниц = кр_ТочкиПродаж.ЗагрузитьГраницыРайонов();
	РезультатМеркурия = кр_ИсточникМеркурий.ЗагрузитьПлощадки();
	ТекстИтога = СтрШаблон("%1. %2. %3. За %4 с.", РезультатЗагрузки.Описание, РезультатГраниц.Описание, РезультатМеркурия.Описание,
		Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) / 1000));
	ЗагрузкаУспешна = РезультатЗагрузки.Успешно И РезультатГраниц.Успешно И РезультатМеркурия.Успешно;
	ЗаписьЖурналаРегистрации("КартаОбъектов.ЗагрузкаТочекПродаж",
		?(ЗагрузкаУспешна, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение), , , ТекстИтога);

КонецПроцедуры

#КонецОбласти

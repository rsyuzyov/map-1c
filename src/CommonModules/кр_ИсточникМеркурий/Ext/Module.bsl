#Область ПрограммныйИнтерфейс

// Загружает из ФГИС Меркурий (Ветис.API, Цербер) действующие площадки Пермского края, в названии или пояснении
// к адресу которых видна розница или общепит, в регистр кр_ТочкиПродаж (источник "Меркурий" заменяется целиком).
// Координаты прежней загрузки сохраняются, если адрес не изменился; новые адреса ждут ДогеокодироватьПлощадки.
//
// Возвращаемое значение:
//  Структура - Успешно (Булево), Описание (Строка).
//
Функция ЗагрузитьПлощадки() Экспорт

	РезультатЗагрузки = Новый Структура("Успешно, Описание", Ложь, "");
	ПараметрыПодключения = ПараметрыПодключения();
	Если ПараметрыПодключения = Неопределено Тогда
		РезультатЗагрузки.Описание = "Меркурий: не задана учетная запись (константа кр_ПодключениеВетис)";
		Возврат РезультатЗагрузки;
	КонецЕсли;

	ПрежниеТочки = ПрежниеТочкиМеркурия();
	НаборТочек = РегистрыСведений.кр_ТочкиПродаж.СоздатьНаборЗаписей();
	НаборТочек.Отбор.Источник.Установить(ИмяИсточника());
	ИтогиРазбора = Новый Структура("МоментЗагрузки, Всего, Просмотрено, Отобрано, Идентификаторы",
		ТекущаяДатаСеанса(), Неопределено, 0, 0, Новый Соответствие);

	Соединение = Новый HTTPСоединение("api.vetrf.ru", 443, ПараметрыПодключения.Логин, ПараметрыПодключения.Пароль, , 600,
		Новый ЗащищенноеСоединениеOpenSSL);
	РазмерСтраницы = 1000;
	Смещение = 0;
	Пока ИтогиРазбора.Всего = Неопределено Или Смещение < ИтогиРазбора.Всего Цикл
		ТекстСтраницы = СтраницаПредприятий(Соединение, Смещение, РазмерСтраницы, РезультатЗагрузки);
		Если ТекстСтраницы = Неопределено Тогда
			РезультатЗагрузки.Описание = СтрШаблон("Меркурий: на смещении %1 %2, прежние точки оставлены", Смещение, РезультатЗагрузки.Описание);
			Возврат РезультатЗагрузки;
		КонецЕсли;
		РазобратьСтраницу(ТекстСтраницы, НаборТочек, ПрежниеТочки, ИтогиРазбора);
		Если ИтогиРазбора.Всего = Неопределено Тогда
			РезультатЗагрузки.Описание = СтрШаблон("Меркурий: на смещении %1 ответ без списка предприятий, прежние точки оставлены", Смещение);
			Возврат РезультатЗагрузки;
		КонецЕсли;
		Смещение = Смещение + РазмерСтраницы;
		Если Смещение % (50 * РазмерСтраницы) = 0 Тогда
			ЗаписьЖурналаРегистрации("КартаОбъектов.ЗагрузкаТочекПродаж", УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Меркурий: пройдено %1 из %2 записей, отобрано %3", Смещение, ИтогиРазбора.Всего, ИтогиРазбора.Отобрано));
		КонецЕсли;
	КонецЦикла;

	НаборТочек.Записать();
	кр_ТочкиПродаж.ПересчитатьБлижайшихКлиентов();

	РезультатЗагрузки.Успешно = Истина;
	РезультатЗагрузки.Описание = СтрШаблон("Меркурий: записей %1, просмотрено %2, отобрано площадок %3",
		ИтогиРазбора.Всего, ИтогиРазбора.Просмотрено, ИтогиРазбора.Отобрано);
	Возврат РезультатЗагрузки;

КонецФункции

// Определяет координаты площадок Меркурия, у которых их еще не искали.
//
// Параметры:
//  ИнтервалМеждуЗапросамиМс - Число - промежуток между запросами к геокодеру.
//  ПределВремениМс - Число - сколько можно работать.
//
// Возвращаемое значение:
//  Структура - Найдено, НеНайдено, Осталось (Число), ОписаниеОстановки (Строка).
//
Функция ДогеокодироватьПлощадки(ИнтервалМеждуЗапросамиМс, ПределВремениМс) Экспорт

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИтогГеокодирования = Новый Структура("Найдено, НеНайдено, Осталось, ОписаниеОстановки", 0, 0, 0, "");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Точки.Идентификатор КАК Идентификатор,
	|	Точки.ЧастиАдреса КАК ЧастиАдреса
	|ИЗ
	|	РегистрСведений.кр_ТочкиПродаж КАК Точки
	|ГДЕ
	|	Точки.Источник = &Источник
	|	И Точки.СостояниеКоординат = """"");
	Запрос.УстановитьПараметр("Источник", ИмяИсточника());
	ТочкиБезКоординат = Запрос.Выполнить().Выгрузить();
	ИтогГеокодирования.Осталось = ТочкиБезКоординат.Количество();

	Для Каждого СтрокаТочки Из ТочкиБезКоординат Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала > ПределВремениМс Тогда
			ИтогГеокодирования.ОписаниеОстановки = "вышло время";
			Прервать;
		КонецЕсли;

		ЧастиАдреса = СтрРазделить(СтрокаТочки.ЧастиАдреса + "||", "|");
		РезультатГеокодирования = кр_Геокодер.КоординатыПоЧастям("Пермский край", ЧастиАдреса[0], ЧастиАдреса[1], ЧастиАдреса[2],
			ИнтервалМеждуЗапросамиМс);
		Если РезультатГеокодирования.Найдено Тогда
			ЗаписатьКоординатыТочки(СтрокаТочки.Идентификатор, РезультатГеокодирования.Широта, РезультатГеокодирования.Долгота, "Найдено");
			ИтогГеокодирования.Найдено = ИтогГеокодирования.Найдено + 1;
		ИначеЕсли РезультатГеокодирования.ОписаниеОшибки = "Адрес не найден"
			Или РезультатГеокодирования.ОписаниеОшибки = "Пустой адрес" Тогда
			ЗаписатьКоординатыТочки(СтрокаТочки.Идентификатор, 0, 0, "НеНайдено");
			ИтогГеокодирования.НеНайдено = ИтогГеокодирования.НеНайдено + 1;
		Иначе
			ИтогГеокодирования.ОписаниеОстановки = "геокодер недоступен: " + РезультатГеокодирования.ОписаниеОшибки;
			Прервать;
		КонецЕсли;
		ИтогГеокодирования.Осталось = ИтогГеокодирования.Осталось - 1;
	КонецЦикла;

	Если ИтогГеокодирования.Найдено > 0 Тогда
		кр_ТочкиПродаж.ПересчитатьБлижайшихКлиентов();
	КонецЕсли;

	Возврат ИтогГеокодирования;

КонецФункции

// Сохраняет учетную запись справочников Ветис.API (логин и пароль для загрузки НСИ).
Процедура СохранитьПараметрыПодключения(Логин, Пароль) Экспорт

	ПараметрыПодключения = Новый Структура("Логин, Пароль", Логин, Пароль);
	Константы.кр_ПодключениеВетис.Установить(Новый ХранилищеЗначения(ПараметрыПодключения));

КонецПроцедуры

Функция ИмяИсточника() Экспорт

	Возврат "Меркурий";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыПодключения()

	ХранилищеПараметров = Константы.кр_ПодключениеВетис.Получить();
	ПараметрыПодключения = ?(ТипЗнч(ХранилищеПараметров) = Тип("ХранилищеЗначения"), ХранилищеПараметров.Получить(), Неопределено);
	Если ТипЗнч(ПараметрыПодключения) <> Тип("Структура") Или Не ПараметрыПодключения.Свойство("Логин")
		Или ПустаяСтрока(ПараметрыПодключения.Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыПодключения;

КонецФункции

// Страница GetRussianEnterpriseList по Пермскому краю; при сбое один повтор через минуту.
Функция СтраницаПредприятий(Соединение, Смещение, РазмерСтраницы, РезультатЗагрузки)

	ТелоЗапроса = "<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
		+ " xmlns:ws=""http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2"" xmlns:bs=""http://api.vetrf.ru/schema/cdm/base"""
		+ " xmlns:dt=""http://api.vetrf.ru/schema/cdm/dictionary/v2""><soapenv:Header/><soapenv:Body>"
		+ "<ws:getRussianEnterpriseListRequest><bs:listOptions><bs:count>" + Формат(РазмерСтраницы, "ЧГ=0") + "</bs:count>"
		+ "<bs:offset>" + Формат(Смещение, "ЧН=0; ЧГ=0") + "</bs:offset></bs:listOptions>"
		+ "<dt:enterprise><dt:address><dt:region><bs:guid>" + ИдентификаторПермскогоКрая() + "</bs:guid></dt:region></dt:address></dt:enterprise>"
		+ "</ws:getRussianEnterpriseListRequest></soapenv:Body></soapenv:Envelope>";

	Для НомерПопытки = 1 По 2 Цикл
		Если НомерПопытки > 1 Тогда
			кр_Геокодер.Подождать(60000);
		КонецЕсли;
		HTTPЗапрос = Новый HTTPЗапрос("/platform/services/2.1/EnterpriseService");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/xml;charset=UTF-8");
		HTTPЗапрос.Заголовки.Вставить("SOAPAction", "GetRussianEnterpriseList");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Попытка
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Исключение
			РезультатЗагрузки.Описание = "Ветис.API недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Возврат HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		КонецЕсли;
		РезультатЗагрузки.Описание = "Ветис.API ответил HTTP " + HTTPОтвет.КодСостояния;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Потоковый разбор страницы: отобранные площадки добавляются в набор, итоги - в ИтогиРазбора.
Процедура РазобратьСтраницу(ТекстСтраницы, НаборТочек, ПрежниеТочки, ИтогиРазбора)

	ЧтениеСтраницы = Новый ЧтениеXML;
	ЧтениеСтраницы.УстановитьСтроку(ТекстСтраницы);
	ПутьЭлементов = Новый Массив;
	ГлубинаПлощадки = Неопределено;
	ПоляПлощадки = Неопределено;
	ИтогиРазбора.Всего = Неопределено;

	Пока ЧтениеСтраницы.Прочитать() Цикл
		Если ЧтениеСтраницы.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ПутьЭлементов.Добавить(ЧтениеСтраницы.ЛокальноеИмя);
			Если ЧтениеСтраницы.ЛокальноеИмя = "enterpriseList" Тогда
				ИтогиРазбора.Всего = Число(ЧтениеСтраницы.ЗначениеАтрибута("total"));
			ИначеЕсли ЧтениеСтраницы.ЛокальноеИмя = "enterprise" И ГлубинаПлощадки = Неопределено Тогда
				ГлубинаПлощадки = ПутьЭлементов.ВГраница();
				ПоляПлощадки = Новый Соответствие;
			КонецЕсли;
		ИначеЕсли ЧтениеСтраницы.ТипУзла = ТипУзлаXML.Текст И ПоляПлощадки <> Неопределено Тогда
			ЧастиПути = Новый Массив;
			Для НомерЭлемента = ГлубинаПлощадки + 1 По ПутьЭлементов.ВГраница() Цикл
				ЧастиПути.Добавить(ПутьЭлементов[НомерЭлемента]);
			КонецЦикла;
			ПоляПлощадки.Вставить(СтрСоединить(ЧастиПути, "/"), ЧтениеСтраницы.Значение);
		ИначеЕсли ЧтениеСтраницы.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ГлубинаПлощадки <> Неопределено И ПутьЭлементов.ВГраница() = ГлубинаПлощадки Тогда
				ИтогиРазбора.Просмотрено = ИтогиРазбора.Просмотрено + 1;
				Если ДобавитьПлощадку(ПоляПлощадки, НаборТочек, ПрежниеТочки, ИтогиРазбора) Тогда
					ИтогиРазбора.Отобрано = ИтогиРазбора.Отобрано + 1;
				КонецЕсли;
				ГлубинаПлощадки = Неопределено;
				ПоляПлощадки = Неопределено;
			КонецЕсли;
			ПутьЭлементов.Удалить(ПутьЭлементов.ВГраница());
		КонецЕсли;
	КонецЦикла;
	ЧтениеСтраницы.Закрыть();

КонецПроцедуры

// Площадка, уже встреченная на прежней странице, пропускается: за час выгрузки записи сдвигаются между страницами.
Функция ДобавитьПлощадку(ПоляПлощадки, НаборТочек, ПрежниеТочки, ИтогиРазбора)

	Если ПоляПлощадки.Получить("active") <> "true" Или ПоляПлощадки.Получить("last") <> "true"
		Или ПоляПлощадки.Получить("registryStatus") = "CANCELED" Тогда
		Возврат Ложь;
	КонецЕсли;
	НомерДома = ЗначениеПоля(ПоляПлощадки, "address/house");
	Если ПустаяСтрока(НомерДома) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИдентификаторПлощадки = ЗначениеПоля(ПоляПлощадки, "guid");
	Если ИтогиРазбора.Идентификаторы.Получить(ИдентификаторПлощадки) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Название = ЗначениеПоля(ПоляПлощадки, "name");
	ПояснениеАдреса = ЗначениеПоля(ПоляПлощадки, "address/additionalInfo");
	Категория = КатегорияПоНазванию(Название + " " + ПояснениеАдреса);
	Если ПустаяСтрока(Категория) Тогда
		Возврат Ложь;
	КонецЕсли;

	НаселенныйПункт = ЗначениеПоля(ПоляПлощадки, "address/subLocality/name");
	Если ПустаяСтрока(НаселенныйПункт) Тогда
		НаселенныйПункт = ЗначениеПоля(ПоляПлощадки, "address/locality/name");
	КонецЕсли;
	ЧастиАдреса = Лев(НаселенныйПункт + "|" + ЗначениеПоля(ПоляПлощадки, "address/street/name") + "|" + НомерДома, 300);
	ПредставлениеАдреса = СтрЗаменить(СтрЗаменить(ЗначениеПоля(ПоляПлощадки, "address/addressView"),
		"Российская Федерация, ", ""), "Пермский край, ", "");

	ЗаписьТочки = НаборТочек.Добавить();
	ЗаписьТочки.Источник = ИмяИсточника();
	ЗаписьТочки.Идентификатор = ИдентификаторПлощадки;
	ИтогиРазбора.Идентификаторы.Вставить(ИдентификаторПлощадки, Истина);
	ЗаписьТочки.Название = Лев(Название + ?(ПустаяСтрока(ПояснениеАдреса), "", " " + ПояснениеАдреса), 200);
	ЗаписьТочки.Категория = Категория;
	ЗаписьТочки.Вид = ВидПоКатегории(Категория);
	ЗаписьТочки.Адрес = Лев(ПредставлениеАдреса, 300);
	ЗаписьТочки.ЧастиАдреса = ЧастиАдреса;
	ЗаписьТочки.ДатаЗагрузки = ИтогиРазбора.МоментЗагрузки;

	ПрежняяТочка = ПрежниеТочки.Получить(ЗаписьТочки.Идентификатор);
	Если ПрежняяТочка <> Неопределено И ПрежняяТочка.ЧастиАдреса = ЧастиАдреса Тогда
		ЗаписьТочки.Широта = ПрежняяТочка.Широта;
		ЗаписьТочки.Долгота = ПрежняяТочка.Долгота;
		ЗаписьТочки.СостояниеКоординат = ПрежняяТочка.СостояниеКоординат;
		ЗаписьТочки.БлижайшийДоговор = ПрежняяТочка.БлижайшийДоговор;
		ЗаписьТочки.РасстояниеДоКлиента = ПрежняяТочка.РасстояниеДоКлиента;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЗначениеПоля(ПоляПлощадки, ИмяПоля)

	ЗначениеПоляПлощадки = ПоляПлощадки.Получить(ИмяПоля);
	Возврат ?(ЗначениеПоляПлощадки = Неопределено, "", СокрЛП(ЗначениеПоляПлощадки));

КонецФункции

// Розница и общепит по словам в названии и пояснении к адресу; пустая строка - не торговая точка.
Функция КатегорияПоНазванию(ИсходныйТекст)

	ТекстПоиска = " " + НРег(СтрЗаменить(ИсходныйТекст, "ё", "е")) + " ";
	Для Каждого ЗнакПрепинания Из СтрРазделить("""|«|»|(|)|,|.|-|№|&|/", "|") Цикл
		ТекстПоиска = СтрЗаменить(ТекстПоиска, ЗнакПрепинания, " ");
	КонецЦикла;

	Если ЕстьФрагмент(ТекстПоиска, "ресторан, бар , паб , пивн, кальян") Тогда
		Возврат "Бары и рестораны";
	КонецЕсли;
	Если ЕстьФрагмент(ТекстПоиска, "кафе, кафетерий, столов, кулинар, пекарн, пиццер, шаурм, шаверм, закусочн, буфет, кофейн, бистро, "
		+ "блинн, пельмен, суши , фастфуд, фаст фуд, бургер") Тогда
		Возврат "Общепит";
	КонецЕсли;
	Если ЕстьФрагмент(ТекстПоиска, "магазин, маркет, супермаркет, минимаркет, гипермаркет, продукт, гастроном, универсам, лавка, ларек, "
		+ "киоск, павильон, пятерочка, монетка, магнит , дикси, светофор, бристоль, красное белое, верный , лента , ашан, перекресток, "
		+ "чижик, семишагофф, впрок") Тогда
		Возврат "Продукты";
	КонецЕсли;

	Возврат "";

КонецФункции

// Фрагменты через запятую; ведущий и замыкающий пробел внутри фрагмента означают границу слова.
Функция ЕстьФрагмент(ТекстПоиска, СписокФрагментов)

	Для Каждого ФрагментСписка Из СтрРазделить(СписокФрагментов, ",", Ложь) Цикл
		ФрагментПоиска = ?(Лев(ФрагментСписка, 1) = " ", Сред(ФрагментСписка, 2), ФрагментСписка);
		Если СтрНайти(ТекстПоиска, " " + ФрагментПоиска) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВидПоКатегории(Категория)

	Если Категория = "Продукты" Тогда
		Возврат "mercury_shop";
	ИначеЕсли Категория = "Общепит" Тогда
		Возврат "mercury_catering";
	КонецЕсли;

	Возврат "mercury_bar";

КонецФункции

Функция ПрежниеТочкиМеркурия()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Точки.Идентификатор КАК Идентификатор,
	|	Точки.ЧастиАдреса КАК ЧастиАдреса,
	|	Точки.Широта КАК Широта,
	|	Точки.Долгота КАК Долгота,
	|	Точки.СостояниеКоординат КАК СостояниеКоординат,
	|	Точки.БлижайшийДоговор КАК БлижайшийДоговор,
	|	Точки.РасстояниеДоКлиента КАК РасстояниеДоКлиента
	|ИЗ
	|	РегистрСведений.кр_ТочкиПродаж КАК Точки
	|ГДЕ
	|	Точки.Источник = &Источник");
	Запрос.УстановитьПараметр("Источник", ИмяИсточника());

	ПрежниеТочки = Новый Соответствие;
	ВыборкаТочек = Запрос.Выполнить().Выбрать();
	Пока ВыборкаТочек.Следующий() Цикл
		ОписаниеТочки = Новый Структура("ЧастиАдреса, Широта, Долгота, СостояниеКоординат, БлижайшийДоговор, РасстояниеДоКлиента");
		ЗаполнитьЗначенияСвойств(ОписаниеТочки, ВыборкаТочек);
		ПрежниеТочки.Вставить(ВыборкаТочек.Идентификатор, ОписаниеТочки);
	КонецЦикла;

	Возврат ПрежниеТочки;

КонецФункции

Процедура ЗаписатьКоординатыТочки(Идентификатор, Широта, Долгота, СостояниеКоординат)

	МенеджерЗаписи = РегистрыСведений.кр_ТочкиПродаж.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Источник = ИмяИсточника();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи.Широта = Широта;
	МенеджерЗаписи.Долгота = Долгота;
	МенеджерЗаписи.СостояниеКоординат = СостояниеКоординат;
	МенеджерЗаписи.Записать();

КонецПроцедуры


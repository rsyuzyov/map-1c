#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьКартуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТорговыйПредставительПриИзменении(Элемент)

	ОбновитьКартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КартаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ИндексТочки = ИндексТочкиПоСсылке(ДанныеСобытия.Href);
	Если ИндексТочки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Если ИндексТочки < ОбъектыТочек.Количество() Тогда
		ПоказатьЗначение(, ОбъектыТочек[ИндексТочки].Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БезКоординатВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаБезКоординат = БезКоординат.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаБезКоординат <> Неопределено Тогда
		ПоказатьЗначение(, СтрокаБезКоординат.Договор);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьКартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ГеокодироватьОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТорговыйПредставитель) Тогда
		ПоказатьПредупреждение(, "Выберите торгового представителя.");
		Возврат;
	КонецЕсли;

	ТекстИтога = ГеокодироватьНаСервере();
	ОбновитьКартуНаСервере();
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьКартуНаСервере()

	ОбъектыТочек.Очистить();
	БезКоординат.Очистить();
	Точки = Новый Массив;

	Если Не ЗначениеЗаполнено(ТорговыйПредставитель) Тогда
		Сводка = "Выберите торгового представителя";
		КартаHTML = кр_Карта.HTMLКарты(Точки);
		Возврат;
	КонецЕсли;

	ДоговорыПредставителя = кр_ИсточникДоговоры.ДоговорыТорговогоПредставителя(ТорговыйПредставитель);
	КоординатыПоДоговорам = кр_Карта.КоординатыОбъектов(ДоговорыПредставителя.ВыгрузитьКолонку("Договор"));

	ДоговоровБезАдреса = 0;
	НеНайдено = 0;
	НеИскали = 0;
	Приблизительно = 0;
	Для Каждого СтрокаДоговора Из ДоговорыПредставителя Цикл
		КоординатыДоговора = КоординатыПоДоговорам.Получить(СтрокаДоговора.Договор);
		ПричинаБезКоординат = "";
		Если ПустаяСтрока(СтрокаДоговора.Адрес) Тогда
			ДоговоровБезАдреса = ДоговоровБезАдреса + 1;
			ПричинаБезКоординат = "Нет адреса доставки";
		ИначеЕсли КоординатыДоговора = Неопределено Тогда
			НеИскали = НеИскали + 1;
			ПричинаБезКоординат = "Координаты еще не определяли";
		ИначеЕсли КоординатыДоговора.Широта = 0 Тогда
			НеНайдено = НеНайдено + 1;
			ПричинаБезКоординат = "Геокодер не нашел адрес";
		КонецЕсли;

		Если Не ПустаяСтрока(ПричинаБезКоординат) Тогда
			СтрокаБезКоординат = БезКоординат.Добавить();
			СтрокаБезКоординат.Договор = СтрокаДоговора.Договор;
			СтрокаБезКоординат.Адрес = СтрокаДоговора.Адрес;
			СтрокаБезКоординат.Причина = ПричинаБезКоординат;
			Продолжить;
		КонецЕсли;

		ТочкаПриблизительная = СтрНайти(КоординатыДоговора.Точность, "(без") > 0;
		Если ТочкаПриблизительная Тогда
			Приблизительно = Приблизительно + 1;
		КонецЕсли;
		ТочкаКарты = Новый Структура("Широта, Долгота, Заголовок, Описание, Индекс, Приблизительно",
			КоординатыДоговора.Широта, КоординатыДоговора.Долгота,
			СтрокаДоговора.Наименование, СтрокаДоговора.Адрес, ОбъектыТочек.Количество(), ТочкаПриблизительная);
		Точки.Добавить(ТочкаКарты);
		ОбъектыТочек.Добавить(СтрокаДоговора.Договор);
	КонецЦикла;

	Сводка = СтрШаблон("Договоров: %1, на карте: %2 (приблизительно: %3), без адреса: %4, не найдено: %5, не искали: %6",
		ДоговорыПредставителя.Количество(), Точки.Количество(), Приблизительно, ДоговоровБезАдреса, НеНайдено, НеИскали);
	КартаHTML = кр_Карта.HTMLКарты(Точки);

КонецПроцедуры

&НаСервере
Функция ГеокодироватьНаСервере()

	МаксимумЗапросов = 30;
	ДоговорыПредставителя = кр_ИсточникДоговоры.ДоговорыТорговогоПредставителя(ТорговыйПредставитель);
	КоординатыПоДоговорам = кр_Карта.КоординатыОбъектов(ДоговорыПредставителя.ВыгрузитьКолонку("Договор"));

	Найдено = 0;
	НеНайдено = 0;
	Для Каждого СтрокаДоговора Из ДоговорыПредставителя Цикл
		Если Найдено + НеНайдено >= МаксимумЗапросов Тогда
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаДоговора.Адрес)
			Или КоординатыПоДоговорам.Получить(СтрокаДоговора.Договор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РезультатГеокодирования = кр_Геокодер.КоординатыПоАдресу(СтрокаДоговора.Адрес);
		Если РезультатГеокодирования.Найдено Тогда
			Найдено = Найдено + 1;
			кр_Карта.ЗаписатьКоординаты(СтрокаДоговора.Договор, РезультатГеокодирования.Широта,
				РезультатГеокодирования.Долгота, "Nominatim", РезультатГеокодирования.Точность, СтрокаДоговора.Адрес);
		ИначеЕсли РезультатГеокодирования.ОписаниеОшибки = "Адрес не найден" Тогда
			НеНайдено = НеНайдено + 1;
			кр_Карта.ЗаписатьКоординаты(СтрокаДоговора.Договор, 0, 0, "Nominatim",
				РезультатГеокодирования.ОписаниеОшибки, СтрокаДоговора.Адрес);
		Иначе
			Возврат СтрШаблон("Геокодер недоступен: %1. Найдено координат: %2, не найдено: %3.",
				РезультатГеокодирования.ОписаниеОшибки, Найдено, НеНайдено);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("Найдено координат: %1, не найдено: %2 (за один раз не больше %3 адресов).",
		Найдено, НеНайдено, МаксимумЗапросов);

КонецФункции

&НаСервереБезКонтекста
Функция ИндексТочкиПоСсылке(Знач Ссылка)

	Возврат кр_Карта.ИндексТочкиПоСсылке(Ссылка);

КонецФункции

#КонецОбласти
